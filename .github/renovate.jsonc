{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process custom dependencies",
      "managerFilePatterns": [
        "/\\.ya?ml$/",
        "/\\.go$/",
        "/^PROJECT$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?\".*:(?<currentValue>.*)\""
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Makefile/"
      ],
      "matchStrings": [
        "https://github.com/(?<packageName>.*)/releases/download/(?<currentValue>[^\\s]+)/[^\\s]+"
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "/^k8s\\.io\\/api/",
        "/^k8s\\.io\\/apimachinery/",
        "/^k8s\\.io\\/client-go/"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "go",
        "github-release-attachments"
      ],
      "matchPackageNames": [
        "sigs.k8s.io/gateway-api",
        "sigs.k8s.io/gateway-api/conformance",
        "kubernetes-sigs/gateway-api"
      ],
      "groupName": "Gateway API",
      "groupSlug": "kubernetes-sigs/gateway-api"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/onsi/ginkgo/v2",
        "github.com/onsi/gomega"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "addLabels": [
        "ci/automerge"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "docker/login-action",
        "github/codeql-action",
        "helm/kind-action",
        "securego/gosec"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "addLabels": [
        "ci/automerge"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/cloudflare/cloudflared"
      ],
      "addLabels": [
        "ci/automerge"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/devcontainers/go"
      ],
      "addLabels": [
        "ci/no-tests"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/devcontainers/go"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "addLabels": [
        "ci/automerge"
      ],
      "automerge": true,
      "ignoreTests": true
    }
  ]
}
